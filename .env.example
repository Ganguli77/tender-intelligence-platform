VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://ideal-surprise-production-7932.up.railway.app,https://nextender.com,https://www.nextender.com

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/nextender_ai?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=update
JWT_SECRET=replace-with-a-strong-32-byte-minimum-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
SERVER_PORT=8081

AI_PROVIDER=openai
SPRING_AI_MODEL_CHAT=openai
AI_TIMEOUT_SECONDS=30
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# For Gemini Developer API keys from Google AI Studio, use:
# AI_PROVIDER=gemini
# SPRING_AI_MODEL_CHAT=none
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# For Gemini through Spring AI Vertex AI instead, use:
# AI_PROVIDER=vertexai
# SPRING_AI_MODEL_CHAT=vertexai
GEMINI_PROJECT_ID=your-google-cloud-project-id
GEMINI_LOCATION=us-central1
GEMINI_CREDENTIALS_URI=file:/absolute/path/to/google-credentials.json
